<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LocalModelManager</AssemblyName>
    <RootNamespace>LocalModelManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\manager.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup><Compile Remove="ManagerClient.cs" /><ProjectReference Include="../desktop-core/AMIEBL.Desktop.Core.csproj" /></ItemGroup>
  <ItemGroup><Content Include="..\assets\manager.ico" Link="assets\manager.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
